  "tutorial": {
    "welcome": {
      "title": "Welcome, adventurer",
      "p1": "This short tour walks through the character builder: what each part of the page is for, and the basic rules behind each step.",
      "note": "This tool does the arithmetic and lays your choices out so they are easy to see. It doesn't replace the rulebooks or your Dungeon Master: read the rules in your books, agree on options with your table, and keep a printed sheet if your group plays with one."
    },
    "progress": {
      "title": "Your progress",
      "p1": "Every step of the build is listed here. A red count shows how many decisions are still open in that step, and a green check means it's done.",
      "p2": "Click any step or line to jump to it. You can go in any order."
    },
    "identity": {
      "title": "Basics: who they are",
      "p1": "Give your character a name and a portrait. Both can be changed later on the sheet.",
      "p2": "The rest of Basics sets which books and rules this character follows. Ask your Dungeon Master first: these settings change what every other step offers."
    },
    "books": {
      "title": "Basics: books",
      "p1": "Only books turned on here show up in the builder: their species, classes and subclasses, backgrounds, feats, spells and items.",
      "p2": "The three core books (Player's Handbook, Dungeon Master's Guide and Monster Manual) are always on, since every other book builds on them. Use Core only if your table plays with just those.",
      "note": "Turning a book off after choosing from it leaves those choices invalid, so pick your books before going further."
    },
    "extra": {
      "title": "Basics: partnered and playtest",
      "p1": "Playtest content is Unearthed Arcana: rules still being tested, which may change or never be published. Many tables don't allow it.",
      "p2": "Partnered content comes from other publishers working with D&D. Turn it on only for the partners your table uses."
    },
    "tableRules": {
      "title": "Basics: table rules",
      "li1": "**Advancement:** level up at story milestones, or by earning experience points.",
      "li2": "**Hit points on level up:** take each class's fixed value, or roll its hit die.",
      "li3": "**Optional class features:** extra and replacement features some classes can take instead of their originals.",
      "li4": "**Prerequisites:** with these on, feats and multiclassing are only offered when you meet their requirements.",
      "li5": "**Encumbrance:** whether the weight you carry is tracked."
    },
    "species": {
      "title": "Species",
      "p1": "Your species sets your size and speed, gives a few traits (darkvision, resistances, extra languages) and usually some ability score increases.",
      "p2": "Some species ask you to pick which abilities increase, or offer a subspecies with its own traits."
    },
    "classes": {
      "title": "Classes",
      "p1": "Your class is what your character does best: its hit die, proficiencies, features and, for casters, spells. Set the level here.",
      "p2": "Choices are grouped by the level that grants them; open a level to see them. To multiclass, add another class: each one has minimum ability scores."
    },
    "pending": {
      "title": "Decisions still to make",
      "p1": "This red mark sits beside every decision that's still open. When a step has none left, its count in the progress list turns into a check."
    },
    "background": {
      "title": "Background",
      "p1": "Your background is the life your character led before adventuring. It grants a couple of skills, tools or languages, some equipment and a feature.",
      "p2": "Personality traits, ideals, bonds and flaws are written later on the sheet."
    },
    "abilityMethod": {
      "title": "Ability scores: the method",
      "p1": "Six scores describe your character: Strength, Dexterity, Constitution, Intelligence, Wisdom and Charisma.",
      "p2": "First pick how your table generates them: a fixed set of numbers to place, point buy with a budget, or your own rolls."
    },
    "abilityTotals": {
      "title": "Ability scores: the totals",
      "p1": "Each card shows how a total is reached: your base score plus bonuses from species, feats and improvements. The modifier under it is what gets added to rolls.",
      "p2": "Other modifier adds an extra bonus your table grants; Override score replaces the total outright."
    },
    "equipment": {
      "title": "Equipment",
      "p1": "Take the starting equipment your class and background offer, picking one option in each choice, or take your class's starting gold and buy gear later.",
      "p2": "Taking gold asks for a roll; your background's coins are added to it."
    },
    "summary": {
      "title": "Your character so far",
      "p1": "A live preview of the character: ability scores, hit points, armor class and attacks update as you choose."
    },
    "review": {
      "title": "Review and finish",
      "p1": "Review lists anything still open, with a link to each. When nothing is left, Finish character turns the draft into a playable sheet.",
      "p2": "Your draft saves on its own as you go, so you can leave and come back at any time."
    },
    "end": {
      "title": "That’s the tour",
      "p1": "Open it again from this button whenever you need it. Have fun at the table!"
    }
  }
}
